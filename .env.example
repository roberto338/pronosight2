# ══════════════════════════════════════════════
# PronoSight — Configuration (template)
# Copie ce fichier en .env et remplis tes clés
# ══════════════════════════════════════════════

# Port du serveur (défaut: 3000)
PORT=3000

# ── IA PRINCIPALE ──────────────────────────────

# Clé API Google Gemini (proxy web search + fallback)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-xxx

# Modèle Gemini par défaut
GEMINI_MODEL=gemini-2.0-flash

# Clé API Groq (fallback Gemini, gratuit)
# https://console.groq.com → API Keys → Create
GROQ_API_KEY=gsk_xxx

# Clé API Anthropic / Claude (Victor core + generate-picks)
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ── DONNÉES SPORTIVES ──────────────────────────

# The Odds API — cotes en temps réel (500 req/mois gratuit)
# https://the-odds-api.com → Sign Up
ODDS_API_KEY=

# football-data.org — calendriers et résultats (10 req/min gratuit)
# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# API-Football via RapidAPI — stats, forme, blessures (100 req/jour gratuit)
# https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=

# ── BASE DE DONNÉES ────────────────────────────

# PostgreSQL (Render.com free tier ou local)
# Format : postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/pronosight

# ── BOT TELEGRAM ───────────────────────────────

# Token du bot (créer via @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=123456789:AAF-xxx

# ID du canal ou groupe de diffusion (ex: @moncanal ou -100xxxxxxxxx)
TELEGRAM_CHANNEL_ID=@pronosight_channel

# ID Telegram de l'admin — sert d'autorisation pour Nexus (agents, cron,
# moteurs autonomes). Obtenir via @userinfobot.
TELEGRAM_ADMIN_ID=

# ── Clé API interne (protège POST /api/victor/refresh) ──
# Générer avec : node -e "import('crypto').then(c => console.log(c.default.randomBytes(32).toString('hex')))"
VICTOR_API_KEY=

# ══════════════════════════════════════════════════════
# NEXUS
# ══════════════════════════════════════════════════════

# ── OBLIGATOIRE ────────────────────────────────
# Mot de passe du chat web /nexus/chat et du dashboard (Basic Auth,
# utilisateur « roberto »). SANS CETTE VARIABLE, /nexus/chat répond 503.
NEXUS_CHAT_PASSWORD=

# Utilisateur du Basic Auth (défaut : roberto)
NEXUS_CHAT_USER=roberto

# Clé API des routes /nexus/* programmatiques. Si absente, VICTOR_API_KEY
# est utilisée en repli.
NEXUS_API_KEY=

# ── GOOGLE OAUTH (agent Google : Gmail, Calendar, Drive) ──
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pronosight2.onrender.com/nexus/google/callback

# ── INTÉGRATIONS DES MOTEURS AUTONOMES (toutes optionnelles) ──
# Sans ces clés, le moteur correspondant se désactive proprement.

# saasFactory — création de dépôts et déploiement
GITHUB_TOKEN=
RENDER_API_KEY=
NETLIFY_TOKEN=

# revenueTracker — suivi du chiffre d'affaires
STRIPE_SECRET_KEY=

# outreachEngine — envoi d'emails
BREVO_API_KEY=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# contentEngine — publication sur les réseaux
BUFFER_TOKEN=
BUFFER_PROFILE_IDS=

# ══════════════════════════════════════════════════════
# RÉGLAGES (valeurs par défaut entre parenthèses)
# ══════════════════════════════════════════════════════

# ── Modèles ────────────────────────────────────
CHAT_MODEL=claude-haiku-4-5
VISION_MODEL=claude-sonnet-5
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_SEARCH_MODEL=
GEMMA_MODEL=

# ── Fiabilité ──────────────────────────────────
# Timeout des appels IA, en ms (90000). Au-delà, l'appel est abandonné :
# sans plafond, un appel lent immobilise un slot du worker Nexus.
AI_TIMEOUT_MS=90000

# Timeout des API métier non-IA — Stripe, Brevo, GitHub, Render, Netlify,
# Buffer — en ms (30000). Voir nexus/lib/http.js.
API_TIMEOUT_MS=30000

# Une tâche/job 'running' inactive au-delà de ce délai est considérée
# orpheline et reprise ou abandonnée (20 minutes).
JOB_STALE_MINUTES=20

# Au-delà de cette ancienneté, une tâche orpheline n'est plus rejouée :
# son contexte est périmé (2 heures).
JOB_RETRY_WINDOW_HOURS=2

# ── Divers ─────────────────────────────────────
# Nombre max de compétitions interrogées sur The Odds API
ODDS_MAX_COMPETS=

# Fenêtre de vérification des résultats, en jours
CHECK_RESULTS_JOURS=

# URL publique de l'app (repli si RENDER_EXTERNAL_URL est absente)
APP_URL=

# Sources sportives complémentaires
API_FOOTBALL_KEY=
TSDB_KEY=
LIVE_API_KEY=

# NOTE : RENDER_EXTERNAL_URL, RENDER_GIT_COMMIT et RENDER_GIT_BRANCH sont
# injectées automatiquement par Render — ne pas les définir ici.
